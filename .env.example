# ============================================================================
# STUDENT OS — ENVIRONMENT CONFIGURATION
# ============================================================================
# Note: If Supabase or Gemini credentials are omitted, Student OS automatically
# runs in Local Demo Mode with persistent local state so you can develop and
# test all 16 agents and core workflows out-of-the-box.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Configuration (Google Gemini API)
# Recommended supported models: gemini-3.8-flash (default), gemini-2.0-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Cost & Execution Guardrails
MAX_TOKENS_PER_REQUEST=2048
MAX_AGENT_DELEGATION_DEPTH=4
DAILY_TOKEN_BUDGET_PER_USER=50000

